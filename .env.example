# Copier ce fichier en « .env » à côté de docker-compose.yml, puis changer
# TOUTES les valeurs. Le fichier .env ne doit jamais être poussé sur GitHub.

# Mots de passe MySQL (utilisateur de l'API, puis administrateur root)
DB_PASSWORD=a-changer
DB_ROOT_PASSWORD=a-changer-aussi

# Jeton de la page /admin : long et aléatoire, par exemple le résultat de
#   openssl rand -hex 32
ADMIN_TOKEN=a-changer-avec-un-long-jeton-aleatoire

# Port publié sur le serveur (80 par défaut)
WEB_PORT=80
