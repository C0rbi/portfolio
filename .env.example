# Copier ce fichier en « .env » à côté de docker-compose.yml, puis le
# remplir : tant qu'une valeur manque, docker compose refuse de démarrer.
# Le fichier .env ne doit jamais être poussé sur GitHub.
#
# Pour générer un mot de passe solide :  openssl rand -base64 24

# Mots de passe MySQL (utilisateur de l'API, puis administrateur root)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Compte de la page /admin, créé (ou mis à jour) au démarrage de l'API.
# Identifiant difficile à deviner (ni « admin », ni un prénom), par exemple :
#   echo "ancre-$(openssl rand -hex 5)"
# Mot de passe : 12 caractères au moins ; le plus sûr est de le générer.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Port publié sur le serveur (80 par défaut)
WEB_PORT=80
